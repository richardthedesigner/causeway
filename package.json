{
  "name": "causewayside",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build:snapshot": "tsx scripts/build-snapshot.ts",
    "spike": "tsx scripts/spike-edinburgh.ts",
    "build:central": "tsx scripts/build-area.ts edinburgh-central",
    "web:build": "pnpm --filter @causeway/web build",
    "web:dev": "pnpm --filter @causeway/web dev",
    "build:area": "tsx scripts/build-area.ts",
    "report:area": "tsx scripts/report-area.ts",
    "build:places": "tsx scripts/build-places.ts",
    "build:works": "tsx scripts/build-works.ts",
    "build:bus": "tsx scripts/build-bus.ts",
    "build:footways": "tsx scripts/build-council-footways.ts",
    "build:floods": "tsx scripts/build-flood-areas.ts",
    "build:greenspace": "tsx scripts/build-greenspace.ts",
    "build:osm-notes": "tsx scripts/build-osm-notes.ts",
    "build:toilets": "tsx scripts/build-toiletmap.ts",
    "a11y": "node scripts/a11y-check.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/proj4": "^2.19.0",
    "axe-core": "^4.13.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "geotiff": "^3.0.5",
    "proj4": "^2.22.0"
  }
}
